  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint --deny-warnings",
    "check": "npm run lint && npm run build && npm test",
    "test": "npm run test:buttons && npm run test:motion && npm run test:navigation && npm run test:intro && npm run test:layout && npm run test:fallback && npm run test:contact && npm run test:media && npm run test:production && npm run test:contact-card",
    "test:contact-card": "node scripts/check-contact-card.js",
    "test:production": "npm run build && node scripts/check-production.js",
    "test:media": "node scripts/check-media.js",
    "test:contact": "node scripts/check-contact.js",
    "test:motion": "node scripts/check-motion.js",
    "test:navigation": "node scripts/check-navigation.js",
    "test:intro": "node scripts/check-intro.js",
    "test:layout": "node scripts/check-layout.js",
    "test:buttons": "node scripts/check-buttons.js",
    "test:fallback": "node scripts/check-fallback.js",
    "preview": "vite preview",
    "og": "node scripts/generate-og.js"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "framer-motion": "^13.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "puppeteer": "^25.9.0",
    "vite": "^8.2.2"
  }
